# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
.venv-*/
venv/

# ---------- 工具缓存 ----------
.mplconfig/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---------- 数据（体积大 / 许可受限，一律不入库；只保留目录占位） ----------
# 中债版权「未经允许 请勿转载」：原始 xlsx、parquet、manifest/指针 均不可再分发
data/**
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/metadata/.gitkeep
!data/raw_spike/.gitkeep

# ---------- 回测/研究产物（可由 make data && make fit 重建） ----------
artifacts/*
!artifacts/.gitkeep
reports/figures/*
!reports/figures/.gitkeep
# 大体积逐日明细（可重建），只保留汇总统计
reports/curve_fit_fitted_*.csv
reports/curve_fit_residuals_*.csv
reports/curve_fit_params*.csv
reports/curve_fit_bad_dates.csv
reports/curve_factors.csv
reports/curve_factor_jump_sensitivity.csv
# 运行指纹/清单（含本机路径，属运行产物）
reports/curve_reports_manifest.csv
reports/*_meta.json

# 策略回测的逐日大表（可由 `make strategies` 重新生成）；
# 汇总、净值、成本、换手、成交记录仍入库作为证据。
reports/strategy_*_exposure.csv
reports/strategy_*_constraints.csv
# 逐券日快照/逐券归因是中间大表（make strategies / make attribution 可重建）
reports/strategy_*_positions.csv
reports/attribution_*_bonds.csv

# ---------- 系统 ----------
.DS_Store
*.log
